{
	"name": "@2enter/web-kit",
	"version": "0.6.8",
	"author": "davilivob <davilivob@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/2enter/web-kit.git"
	},
	"bugs": {
		"url": "https://github.com/2enter/web-kit/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"src/lib",
		"!src/lib/**/*.test.*",
		"!src/lib/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./*": {
			"types": "./dist/*/index.d.ts",
			"svelte": "./dist/*/index.js",
			"default": "./dist/*/index.js"
		},
		"./tw-plugin/*": {
			"types": "./dist/tw-plugin/*.d.ts",
			"svelte": "./dist/tw-plugin/*.js",
			"default": "./dist/tw-plugin/*.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@cloudflare/speedtest": "^1.6.0",
		"validator": "^13.15.15",
		"tailwind-merge": "^3.3.1",
		"axios": "^1.11.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/enhanced-img": "^0.4.4",
		"@sveltejs/kit": "^2.31.1",
		"@sveltejs/package": "^2.4.1",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@types/validator": "^13.15.2",
		"autoprefixer": "^10.4.21",
		"daisyui": "^4.12.24",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"publint": "^0.3.12",
		"svelte": "^5.38.2",
		"svelte-check": "^4.3.1",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.9.2",
		"vite": "^6.3.5"
	}
}
